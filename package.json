  },
  "engines": {
    "node": ">=18.20.2"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.1",
    "semver": "^7.6.0",
    "smol-toml": "^1.8.0"
